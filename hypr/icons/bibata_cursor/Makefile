# Cursor build integration for Bibata-generated XCursors.

SHELL := bash
.SHELLFLAGS := -euo pipefail -c
.DELETE_ON_ERROR:
PODMAN ?= podman
JQ ?= jq

DOCKER_IMAGE_NAME ?= hypr-bibata-builder
CURSOR_DOCKERFILE ?= $(CURDIR)/Dockerfile
CURSOR_BUILD_SCRIPT ?= $(CURDIR/)build-bibata-cursor.sh
BIBATA_SRC ?= $(CURDIR)/Bibata_Cursor
CURSOR_GEN_DIR ?= $(CURDIR)/generated/cursor
CURSOR_OUT_DIR ?= $(HOME)/.local/share/icons
CURSOR_DEFAULT_SIZE ?= 24

CURSOR_IMAGE_STAMP := .cache/$(DOCKER_IMAGE_NAME).podman_image


$(CURSOR_IMAGE_STAMP): $(CURSOR_DOCKERFILE) $(CURSOR_BUILD_SCRIPT) $(BIBATA_SRC)/.git
	@mkdir -p $(dir $@)
	$(PODMAN) build -f $(CURSOR_DOCKERFILE) -t $(DOCKER_IMAGE_NAME) .
	@touch $@

define RUN_BIBATA_CURSOR_BUILD
	@test -n "$(1)" || { echo "RENDER_JSON is required" >&2; exit 2; }
	@set -euo pipefail; \
		render_json="$$(realpath "$(1)")"; \
		name="$$($(JQ) -r 'keys_unsorted | if length == 1 then .[0] else error("render json must contain exactly one cursor theme") end' "$$render_json")"; \
		size="$$($(JQ) -r --arg name "$$name" '.[$$name].sizes? // empty | if type == "array" then join(" ") else tostring end' "$$render_json")"; \
		if [[ -z "$$size" ]]; then size="$(CURSOR_DEFAULT_SIZE)"; fi; \
		comment="Generated by Hyprland theme on $$(date -Iseconds)"; \
		echo "[cursor] building $$name ($$size)"; \
		$(PODMAN) run --rm --userns=keep-id \
			-e SRC=/src \
			-e OUT=/out \
			-e COMMENT="$$comment" \
			-e RENDER_JSON=/render/render.json \
			-e SIZE="$$size" \
			-v "$(BIBATA_SRC):/src:ro" \
			-v "$$render_json:/render/render.json:ro" \
			-v "$(CURSOR_OUT_DIR):/out" \
			$(DOCKER_IMAGE_NAME)
endef

.PHONY: cursor-build
cursor-build: $(CURSOR_IMAGE_STAMP)
	$(call RUN_BIBATA_CURSOR_BUILD,$(RENDER_JSON))

$(CURSOR_OUT_DIR)/%/index.theme: $(CURSOR_GEN_DIR)/render-%.json $(CURSOR_IMAGE_STAMP)
	$(call RUN_BIBATA_CURSOR_BUILD,$<)

.PHONY: cursor-%
cursor-%: $(CURSOR_OUT_DIR)/%/index.theme
	@true

.PHONY: cursor-image-clean cursor-clean
cursor-image-clean:
	@rm -f $(CURSOR_IMAGE_STAMP)

cursor-clean:
	@rm -rf $(CURSOR_GEN_DIR)
