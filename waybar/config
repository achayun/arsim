/* vim: set syntax=css: */
/* This file uses nedfont glyphs. To find different fonts use: https://www.nerdfonts.com/cheat-sheet */
{
    "reload_style_on_change": true,
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30,
    "margin": "0 0 0 0",
    "spacing": 4,

    "modules-left": [
        "custom/apps",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "custom/updates",
        "custom/cheatsheet",
        // "custom/network_traffic",
        "custom/sensors",
        "cpu",
        "memory",
        "pulseaudio",
        "tray",
        "custom/launcher",
        "custom/power",
        "clock"
    ],

 // Modules configuration

 "hyprland/workspaces": {
     "format": "{id}",
     "on-click": "activate",
     "all-outputs": false,
     "sort-by-number": true,
     "on-scroll-up": "hyprctl dispatch workspace e-1",
     "on-scroll-down": "hyprctl dispatch workspace e+1"
 },
 "hyprland/window": {
     "format": "{}",
     "icon":true,
     "separate-outputs": true,
 },
 "clock": {
     "tooltip-format": "<big>{:%A, %d.%B %Y }</big>\n<tt><small>{calendar}</small></tt>",
     "format": " {:%a %d %b  %H:%M}",    //24 hour format
     // "format-alt": " {:%d/%m/%Y  %H:%M:%S}",   // Enable seconds
     "interval": 1,
     "on-click": "~/.config/waybar/scripts/OCV"
 },
 "network": {
     "format": "⚠Disabled",
     "format-wifi": "{essid}",
     "format-ethernet": "",
     "format-linked": "{ipaddr}",
     "format-disconnected": "⚠Disconnected",
     "format-alt": "{ifname}: {ipaddr}/{cidr}",
     "family": "ipv4",
     "tooltip-format-wifi": " {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
     "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
        //"min-length": 2,
        //"max-length": 2,
        "on-click": "nm-connection-editor"
 },
 "cpu": {
     "format": "CPU{usage}%",
     "on-click": "kitty --class='waybar-popup' btop"
 },
 "custom/sensors": {
     "format": "{}",
     "return-type": "json",
     "exec": "~/.config/waybar/scripts/sensors.sh",
     "interval": 5
 },
 "memory": {
     "format": "RAM{}%",
     "on-click": "kitty --class='waybar-popup' btop"
 },
 "custom/updates": {
     "format": "{} {icon}",
     "return-type": "json",
     "format-icons": {
         "has-updates": "󱍷",
         "updated": "󰂪"
     },
     "exec-if": "which waybar-module-pacman-updates",
     "exec": "waybar-module-pacman-updates --interval-seconds 5 --network-interval-seconds 7200 --network-interval-seconds",
     "on-click": "kitty --class='waybar-popup' update"
 },
 "pulseaudio": {
     "scroll-step": 3, // %, can be a float
     "format": "{icon}{volume}%{format_source}",
     "format-bluetooth": "{icon}{volume}% {format_source}",
     "format-bluetooth-muted": " {icon} {format_source}",
     "format-muted": " {format_source}",
     "format-source": "",
     "format-source-muted": "",
     "format-icons": {
         "headphone": "",
         "hands-free": "",
         "headset": "",
         "phone": "",
         "portable": "",
         "car": "",
         "default": ["", "", ""]
     },
     "on-click": "pavucontrol"
 },
 "tray": {
     "icon-size": 20,
     "spacing": 5
 },
 "custom/power": {
     "format":"󰐥",
     "tooltip": false,
     "on-click": "nwgbar"
 },
 "custom/cheatsheet": {
     "format": " Cheat",
     "on-click": "~/.config/waybar/scripts/hyprcheat.sh"
 },
 "custom/launcher": {
     "format":"",
     "on-click": "hyprlauncher",
     "tooltip": false
 },
 "custom/apps": {
     "format":"",
     "on-click": "exec nwg-drawer -c 7 -is 70 -spacing 23",
     "tooltip": false
 }
}
